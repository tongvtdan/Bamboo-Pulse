#!/bin/sh
bridge_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec "$bridge_dir/../python/bin/python3" -I -S -B -c 'import os,runpy,sys; p=sys.argv[1]; sys.argv=sys.argv[1:]; sys.path.append(os.path.dirname(p)); runpy.run_path(p,run_name="__main__")' "$bridge_dir/desktop_bridge.py" "$@"
